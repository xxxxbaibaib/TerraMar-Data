# 复制为 `.env` 并填写。不要将含真实密钥的 `.env` 提交到 Git。

# Supabase（必填以连接云端；腾讯云/Vercel 等「构建环境变量」里同样配置这两项）
# VITE_SUPABASE_URL=   # Project Settings → API → Project URL，不要带 /rest/v1
# VITE_SUPABASE_ANON_KEY=   # 仅 anon / public，禁止 service_role
#
# 官网 CMS（/admin）：执行 supabase/migrations/20260808120000_cms_website_admin.sql 后，
# 将运营账号 profiles.is_staff=true。Hero 视频优先用 Storage public URL + hero_media 表，
# 以下签名 URL 仅为旧环境兼容，可不配置：
# VITE_HERO_VIDEO_URL_HOME=
# VITE_HERO_VIDEO_URL_PROGRAMS=
# VITE_HERO_VIDEO_URL_COOPERATION=
# VITE_HERO_VIDEO_URL_IMPACT=
# VITE_HERO_VIDEO_URL_SCIENCE=

# 支付 return_url 使用的前端根地址在 Supabase Edge Secrets 中配置为 PUBLIC_SITE_URL（不是 Vite 变量）
# 须与用户浏览器访问的正式站点一致，例如：https://www.example.com
# 生成官网二维码 PNG 时也会读取此项：npm run generate:qrcode
# VITE_PUBLIC_SITE_URL=https://terramarnature.com

# Supabase Auth 回调：在 Dashboard → Authentication → URL 中配置 Site URL 与 Redirect URLs（同上正式域名）

# Geoapify Places API（可选）：周边地图兴趣点优先走 Geoapify，失败回退 Overpass
# VITE_GEOAPIFY_API_KEY=
# 可选，默认 https://api.geoapify.com/v2/places（无 query 参数）
# VITE_GEOAPIFY_PLACES_BASE_URL=

# VITE_USE_MOCK_AUTH=true
